<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd watchdog for the smartrouter server. Copy to
     ~/Library/LaunchAgents/, edit the absolute path to healthcheck.sh, then:
       launchctl load -w ~/Library/LaunchAgents/com.smartrouter.healthcheck.plist
     Runs every 5 minutes; emails via ~/.alert_credentials on failure. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.smartrouter.healthcheck</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/ABSOLUTE/PATH/TO/smart-router/ops/healthcheck.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/smart-router/ops/healthcheck.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/smart-router/ops/healthcheck.log</string>
</dict>
</plist>
